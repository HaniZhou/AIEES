# ============================================
# Docker Compose 配置

COMPOSE_PROJECT_NAME=aiees
VERSION=1.0.0

# ============================================
# JWT 安全配置
SECRET_KEY="your-secret-key-here"

# ============================================
# 管理员账号配置
ADMIN_NAME="Admin"
ADMIN_PASSWORD="your-admin-password"

# ============================================
# AI 配置
AI_MODEL_TEXT="Your MODEL NAME HERE"
AI_MODEL_ASR="Your MODEL NAME HERE"
AI_BASE_URL="http://your-ai-service:3000/v1"
AI_API_KEY="your-api-key-here"

# ============================================
# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ============================================
# 数据库配置（应用连接用）
DB_HOST=db
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-db-password

# ============================================
# PostgreSQL 容器初始化配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-db-password
POSTGRES_DB=postgres

# ============================================
# CORS 允许来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================
# 日志级别（DEBUG / INFO / WARNING / ERROR / CRITICAL）
LOG_LEVEL=INFO
SLOW_QUERY_MS=500
