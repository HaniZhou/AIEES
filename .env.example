#--------------Docker Compose 配置----------------

# Docker Compose 项目名称前缀
COMPOSE_PROJECT_NAME=aiees
# 构建镜像版本标签
VERSION=1.0.0

# FastAPI 应用工作进程数
FASTAPI_CPUS=10
# Taskiq Worker 工作进程数
WORKER_CPUS=4
# Redis 最大内存限制
REDIS_MAXMEMORY=6gb

#--------------JWT 安全配置----------------
# JWT 密钥（生产环境请使用强随机值替换）
SECRET_KEY="your-secret-key-here"

# --------------管理员账号配置------------------
ADMIN_NAME="admin"
ADMIN_PASSWORD="your-admin-password-here"

#--------------AI 配置--------------------
AI_MODEL_TEXT="GLM-5.1"
AI_MODEL_ASR="qwen3-asr"
AI_BASE_URL="http://localhost:3000/v1"
AI_API_KEY="your-api-key-here"

#----------------Redis 配置------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123

#----------------数据库配置（应用连接）------------------
DB_HOST=db
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# 数据库连接池配置
POOL_SIZE=3
MAX_OVERFLOW=2
POOL_PRE_PING=True
POOL_TIMEOUT=30
POOL_RECYCLE=1800

#------------PostgreSQL 容器初始化配置--------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

#----------CORS 配置（逗号分隔）----------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_METHODS=GET,POST,OPTIONS,PUT,DELETE,PATCH
CORS_ALLOW_HEADERS=Content-Type,Authorization,Accept,Origin,X-Requested-With,X-Request-Id

#--------------日志配置------------------
LOG_LEVEL=INFO
SLOW_QUERY_MS=1000
