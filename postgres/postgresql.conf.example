listen_addresses = '*'

# ----------连接与进程------------
max_connections = 100                   # <<<需调整>>> 应用连接数上限
superuser_reserved_connections = 3      # 超级用户应急通道，固定保留
reserved_connections = 0                # 非超级用户管理任务预留，按需开启
max_wal_senders = 10                     # 单机无复制设为0，主从集群按需调整

# ----------内存（假设总内存 8GB，容器实际可用 6GB）------------
shared_buffers = 128MB        # <<<需调整>>> 25%总内存（容器可用内存）
work_mem = 4MB                # <<<需调整>>> OLTP建议4–16MB，混合负载16–32MB
maintenance_work_mem = 64MB    # <<<需调整>>> min(512MB,容器内存5%)
autovacuum_work_mem = -1  		# -1表示复用maintenance_work_mem；减少上的1/4
effective_cache_size = 4GB      # <<<需调整>>> 总内存的50–75%，优化器提示值，不实际分配

# ----------并发与并行（假设可用CPU核数=4）------------
max_worker_processes = 8           # <<<需调整>>> max(2, PG可用核数)
max_parallel_workers = 8                # <<<需调整>>> floor(max_worker_processes/2) 或按需
max_parallel_workers_per_gather = 2   # <<<需调整>>> OLTP 2–4，纯OLAP可用核数一半
max_parallel_maintenance_workers = 2    # <<<需调整>>> 2–4
autovacuum_max_workers = 3              # 默认值，可保持

# ----------预写日志 (WAL)------------
wal_buffers = -1                 # -1自动调整，最大16MB（默认即可）
checkpoint_completion_target = 0.9      # 最佳实践，不需改
max_wal_size = 1GB                      # <<<需调整>>> 生产4–16GB，保证检查点平滑
min_wal_size = 80MB                     # max_wal_size/4
checkpoint_timeout = 5min               # <<<需调整>>> 建议15–30min

# ----------优化器代价------------
random_page_cost = 4.0    # <<<需调整>>> 机械硬盘默认4，SSD/云存储建议实测（可降至1.1~1.5）

# ----------日志（关闭内置收集，输出到stdout/stderr，便于容器采集）------------
# logging_collector = off               # 容器环境关闭，输出到终端由docker记录
log_line_prefix = '%m [%p] %u@%d %h %c %x '
log_error_verbosity = verbose
s
# DDL审计
log_statement = 'ddl'

# 慢查询发现（执行后记录）
log_min_duration_statement = 1000       # 单位毫秒，记录超过1s的查询
log_lock_waits = on
log_temp_files = 10240                  # 记录超过10MB的临时文件
log_autovacuum_min_duration = 10000     # 记录超过10s的autovacuum